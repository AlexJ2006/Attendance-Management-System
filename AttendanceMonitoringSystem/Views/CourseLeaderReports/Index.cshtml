
@model AttendanceMonitoringSystem.Models.AttendanceReportViewModel

@{
    // Use the shared site layout and set the page title.
    Layout = "_Layout";
    ViewData["Title"] = "Course Leader Attendance Reports";
}

<div class="container mt-4">

    @* Page heading and short explanation. *@
    <div class="mb-4">
        <h1>Attendance Reports</h1>
        <p class="text-muted">
            Review attendance across your assigned courses and modules.
        </p>
    </div>

    @* Allow the Course Leader to filter the report. *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Report Filters</h5>
        </div>

        <div class="card-body">
            <form asp-controller="CourseLeaderReports"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label for="startDate" class="form-label">
                            Start date
                        </label>

                        <input type="date"
                               id="startDate"
                               name="startDate"
                               class="form-control"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-3">
                        <label for="endDate" class="form-label">
                            End date
                        </label>

                        <input type="date"
                               id="endDate"
                               name="endDate"
                               class="form-control"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-3">
                        <label for="courseId" class="form-label">
                            Course
                        </label>

                        <select id="courseId"
                                name="courseId"
                                class="form-select">

                            <option value="">All assigned courses</option>

                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.CourseId"
                                        selected="@(Model.CourseId == course.CourseId)">
                                    @course.CourseName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="moduleId" class="form-label">
                            Module
                        </label>

                        <select id="moduleId"
                                name="moduleId"
                                class="form-select">

                            <option value="">All assigned modules</option>

                            @foreach (var module in Model.Modules)
                            {
                                <option value="@module.ModuleId"
                                        selected="@(Model.ModuleId == module.ModuleId)">
                                    @module.ModuleCode - @module.ModuleName
                                </option>
                            }
                        </select>
                    </div>

                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="CourseLeaderReports"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>

            </form>
        </div>
    </div>

    @* Display the overall attendance figures for the selected report. *@
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Records</h6>
                    <h3>@Model.TotalRecords</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Present</h6>
                    <h3>@Model.PresentCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Absent</h6>
                    <h3>@Model.AbsentCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Attendance Rate</h6>
                    <h3>@Model.AttendancePercentage%</h3>
                </div>
            </div>
        </div>

    </div>

    @* Show the remaining attendance categories separately. *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Attendance Breakdown</h5>
        </div>

        <div class="card-body">
            <div class="row text-center">

                <div class="col">
                    <strong>Authorised Absence</strong>
                    <p class="mb-0">@Model.AuthorisedAbsenceCount</p>
                </div>

                <div class="col">
                    <strong>Late Arrival</strong>
                    <p class="mb-0">@Model.LateCount</p>
                </div>

                <div class="col">
                    <strong>Left Early</strong>
                    <p class="mb-0">@Model.LeftEarlyCount</p>
                </div>

                <div class="col">
                    <strong>Not Recorded</strong>
                    <p class="mb-0">@Model.NotRecordedCount</p>
                </div>

            </div>
        </div>
    </div>

    @* Display each student's attendance figures. *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Student Attendance Details</h5>
        </div>

        <div class="card-body">

            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Course</th>
                                <th>Sessions</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Authorised Absence</th>
                                <th>Late</th>
                                <th>Left Early</th>
                                <th>Attendance Rate</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.StudentName</td>
                                    <td>@student.Email</td>
                                    <td>@student.CourseName</td>
                                    <td>@student.TotalSessions</td>
                                    <td>@student.PresentCount</td>
                                    <td>@student.AbsentCount</td>
                                    <td>@student.AuthorisedAbsenceCount</td>
                                    <td>@student.LateCount</td>
                                    <td>@student.LeftEarlyCount</td>
                                    <td>@student.AttendancePercentage%</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                @* Explain when the selected filters produce no attendance records. *@
                <p class="text-muted mb-0">
                    No attendance records were found for the selected filters.
                </p>
            }

        </div>
    </div>

    @* Provide a clear route back to the Course Leader dashboard. *@
    <a asp-controller="CourseLeader"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        Back to Course Leader Dashboard
    </a>

</div>
