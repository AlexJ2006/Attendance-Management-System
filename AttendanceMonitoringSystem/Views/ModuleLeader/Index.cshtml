```cshtml
@model AttendanceMonitoringSystem.Models.ModuleLeaderDashboardViewModel

@{
    ViewData["Title"] = "Module Leader Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1>Module Leader Dashboard</h1>
        <p class="text-muted">
            Monitor attendance, identify students requiring support,
            and review attendance across your assigned modules.
        </p>
    </div>

    <!-- Dashboard summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Assigned Modules</h6>
                    <h2>@Model.Modules.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Low Attendance</h6>
                    <h2 class="text-danger">
                        @Model.LowAttendanceStudents.Count
                    </h2>
                    <small class="text-muted">
                        Below @Model.AttendanceWarningThreshold%
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Disengagement Flags</h6>
                    <h2 class="text-warning">
                        @Model.DisengagedStudents.Count
                    </h2>
                    <small class="text-muted">
                        Two or more consecutive weeks
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Compliance Threshold</h6>
                    <h2>@Model.AttendanceWarningThreshold%</h2>
                    <small class="text-muted">
                        Minimum required attendance
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- Assigned modules -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">My Assigned Modules</h5>
        </div>

        <div class="card-body">

            @if (Model.Modules.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Module Code</th>
                                <th>Module Name</th>
                                <th>Students</th>
                                <th>Attendance</th>
                                <th>Compliance</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var module in Model.Modules)
                            {
                                <tr>
                                    <td>
                                        <strong>@module.ModuleCode</strong>
                                    </td>
                                    <td>@module.ModuleName</td>
                                    <td>@module.StudentCount</td>
                                    <td>
                                        @module.AttendancePercentage.ToString("F1")%
                                    </td>
                                    <td>
                                        @if (module.AttendancePercentage >= Model.AttendanceWarningThreshold)
                                        {
                                            <span class="badge bg-success">
                                                Compliant
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Below Threshold
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No modules have been assigned to you yet.
                </p>
            }

        </div>
    </div>

    <!-- Low attendance students -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Students Below Attendance Threshold</h5>
        </div>

        <div class="card-body">

            @if (Model.LowAttendanceStudents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Module</th>
                                <th>Attended / Eligible</th>
                                <th>Attendance</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.LowAttendanceStudents)
                            {
                                <tr>
                                    <td>@student.StudentName</td>
                                    <td>@student.Email</td>
                                    <td>
                                        @student.ModuleCode
                                        <small class="text-muted d-block">
                                            @student.ModuleName
                                        </small>
                                    </td>
                                    <td>
                                        @student.AttendedCount / @student.TotalRecords
                                    </td>
                                    <td>
                                        @student.AttendancePercentage.ToString("F1")%
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">
                                            Non-compliant
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-success mb-0">
                    No students are currently below the attendance threshold.
                </p>
            }

        </div>
    </div>

    <!-- Disengaged students -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Student Disengagement Alerts</h5>
        </div>

        <div class="card-body">

            @if (Model.DisengagedStudents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Module</th>
                                <th>Consecutive Weeks Without Engagement</th>
                                <th>Action Required</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.DisengagedStudents)
                            {
                                <tr>
                                    <td>@student.StudentName</td>
                                    <td>@student.Email</td>
                                    <td>
                                        @student.ModuleCode
                                        <small class="text-muted d-block">
                                            @student.ModuleName
                                        </small>
                                    </td>
                                    <td>
                                        @student.ConsecutiveWeeksWithoutEngagement
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            Review student
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-success mb-0">
                    No current two-week disengagement alerts.
                </p>
            }

        </div>
    </div>

</div>
```