@using AttendanceMonitoringSystem.Controllers
@model StudentListViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p class="text-muted">@Model.Description</p>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info" role="status">No students were found.</div>
}
else
{
    <div class="mb-3">
        <label for="student-filter" class="form-label">Filter by name or email</label>
        <input id="student-filter" class="form-control" type="search" autocomplete="off" />
    </div>
    <div class="table-responsive card shadow-sm">
        <table class="table table-hover align-middle mb-0" id="student-table">
            <caption class="visually-hidden">@Model.Title with attendance percentage</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Student No.</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Course</th>
                    <th scope="col">Year</th>
                    <th scope="col">Attendance</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students)
                {
                    var low = s.HasRecords && s.Percentage < 75;
                    <tr class="@(low ? "row-warning" : "")">
                        <td>@s.StudentId</td>
                        <td>@s.Name</td>
                        <td>@s.Email</td>
                        <td>@s.CourseName</td>
                        <td>@s.YearOfStudy</td>
                        <td>
                            @(s.HasRecords ? s.Percentage.ToString("0.0") + "%" : "–")
                            @if (low)
                            {
                                <span class="badge text-bg-warning ms-1">⚠ Below 75%</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="EnrolmentDetails" asp-route-studentId="@s.StudentId"
                               aria-label="View attendance for @s.Name">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('student-filter');
            if (!input) return;
            input.addEventListener('input', function () {
                var term = input.value.toLowerCase();
                document.querySelectorAll('#student-table tbody tr').forEach(function (row) {
                    row.hidden = term && row.textContent.toLowerCase().indexOf(term) === -1;
                });
            });
        })();
    </script>
}
