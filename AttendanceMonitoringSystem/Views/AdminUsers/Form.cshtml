@model AttendanceMonitoringSystem.Models.AdminUserFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit user" : "Create user";
    var studentRoleId = Model.AvailableRoles.FirstOrDefault(r => r.RoleName == RoleNames.Student)?.RoleId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@(Model.IsEdit ? "Edit user account" : "Create user account")</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to users</a>
</div>

<p class="text-muted">
    Fields marked <span class="required" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.
</p>

@if (!ViewData.ModelState.IsValid)
{
    @* Figures 3.2.5b / 3.2.5c - required field and format errors. *@
    <div class="alert alert-danger" role="alert" tabindex="-1" id="form-errors">
        <h2 class="h6">The account could not be saved. Please correct the following:</h2>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<form method="post" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.UserId" novalidate class="card shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label">First name <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="FirstName" class="form-control" autocomplete="off" aria-required="true" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label">Last name <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="LastName" class="form-control" autocomplete="off" aria-required="true" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email address <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="off" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label">Department <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="Department" class="form-control" aria-required="true" />
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>

            @if (!Model.IsEdit)
            {
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Initial password <span class="required" aria-hidden="true">*</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="password-help" />
                    <div id="password-help" class="form-text">At least 8 characters with upper-case, lower-case and a number.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <fieldset class="col-md-6">
                    <legend class="form-label fs-6">Roles <span class="required" aria-hidden="true">*</span></legend>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input role-check" type="checkbox" name="SelectedRoleIds"
                                   value="@role.RoleId" id="role-@role.RoleId"
                                   checked="@Model.SelectedRoleIds.Contains(role.RoleId)" />
                            <label class="form-check-label" for="role-@role.RoleId">@RoleNames.Display(role.RoleName)</label>
                        </div>
                    }
                    <span asp-validation-for="SelectedRoleIds" class="text-danger small"></span>
                </fieldset>
            }
            else
            {
                <div class="col-md-6">
                    <p class="form-label mb-1">Roles</p>
                    <p>
                        @foreach (var role in Model.AvailableRoles.Where(r => Model.SelectedRoleIds.Contains(r.RoleId)))
                        {
                            <span class="badge bg-primary me-1">@RoleNames.Display(role.RoleName)</span>
                        }
                        <a asp-action="ManageRoles" asp-route-id="@Model.UserId" class="ms-2">Manage roles</a>
                    </p>
                </div>
            }

            <div class="col-md-6">
                <div class="form-check form-switch mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">Account active (user can sign in)</label>
                </div>
                <span asp-validation-for="IsActive" class="text-danger small"></span>
            </div>
        </div>

        <fieldset id="student-fields" class="border rounded p-3 mt-4"
                  @(Model.IsEdit && !Model.HasStudentRecord ? "hidden" : "")>
            <legend class="float-none w-auto px-2 fs-6">Student details (required for students)</legend>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CourseId" class="form-label">Course</label>
                    <select asp-for="CourseId" asp-items="Model.Courses" class="form-select">
                        <option value="">Select a course</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CohortId" class="form-label">Cohort</label>
                    <select asp-for="CohortId" asp-items="Model.Cohorts" class="form-select">
                        <option value="">Select a cohort</option>
                    </select>
                    <span asp-validation-for="CohortId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="YearOfStudy" class="form-label">Year of study</label>
                    <input asp-for="YearOfStudy" class="form-control" type="number" min="1" max="7" />
                    <span asp-validation-for="YearOfStudy" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Update account" : "Create account")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var errors = document.getElementById('form-errors');
            if (errors) errors.focus();

            // Show the student fields only when the Student role is ticked.
            var studentRoleId = '@studentRoleId';
            var box = document.getElementById('role-' + studentRoleId);
            var fields = document.getElementById('student-fields');
            if (!box || !fields) return;
            function toggle() { fields.hidden = !box.checked; }
            box.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
