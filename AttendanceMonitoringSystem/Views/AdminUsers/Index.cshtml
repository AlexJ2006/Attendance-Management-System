
@model AttendanceMonitoringSystem.Models.AdminUserListViewModel

@{
    // Set the browser page title.
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">

    <!-- Page heading and navigation. -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>User Management</h1>
            <p class="text-muted">
                View user accounts, assigned roles and account status.
            </p>
        </div>

        <a asp-page="/AdminDashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <!-- Display success and error messages. -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Search for users by name or email address. -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="AdminUsers"
                  asp-action="Index"
                  method="get">

                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label for="search" class="form-label">
                            Search users
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Enter a name or email address" />
                    </div>

                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>

                        <a asp-controller="AdminUsers"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Display the number of accounts matching the search. -->
    <div class="mb-3">
        <strong>Accounts found:</strong> @Model.Users.Count
    </div>

    <!-- Display the user accounts and their roles. -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Assigned Roles</th>
                            <th>Account Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Users.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    No user accounts were found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.UserId</td>

                                    <td>@user.Name</td>

                                    <td>@user.Email</td>

                                    <td>
                                        @if (user.RoleNames.Count > 0)
                                        {
                                            @foreach (var role in user.RoleNames)
                                            {
                                                <span class="badge bg-primary me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No roles assigned
                                            </span>
                                        }
                                    </td>

                                    <!-- Display whether the account is active. -->
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- Provide account and role management actions. -->
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <!-- Open the role management page. -->
                                            <a asp-controller="AdminUsers"
                                               asp-action="ManageRoles"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-primary">
                                                Manage Roles
                                            </a>

                                            @if (user.IsActive)
                                            {
                                                <!-- Deactivate an active account. -->
                                                <form asp-controller="AdminUsers"
                                                      asp-action="Deactivate"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to deactivate this account?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.UserId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Deactivate
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <!-- Reactivate an inactive account. -->
                                                <form asp-controller="AdminUsers"
                                                      asp-action="Activate"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to activate this account?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="userId"
                                                           value="@user.UserId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Activate
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <p class="text-muted mt-3">
        Deactivating an account prevents future logins.
        Existing roles and attendance records are preserved.
    </p>

</div>
