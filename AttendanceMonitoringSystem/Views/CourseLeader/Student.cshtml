@model AttendanceMonitoringSystem.Models.CourseLeaderStudentAttendanceViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Student Attendance";
}

<div class="container mt-4">

    @* Display the student's basic information. *@
    <div class="mb-4">

        <h1>
            @Model.Student.FirstName @Model.Student.LastName
        </h1>

        <p class="text-muted mb-1">
            @Model.Student.Email
        </p>

        <p class="text-muted">
            Course: @Model.Student.Course.CourseCode
            - @Model.Student.Course.CourseName
        </p>

        <a asp-controller="CourseLeader"
           asp-action="Course"
           asp-route-id="@Model.Student.CourseId"
           class="btn btn-outline-secondary">
            Back to Course
        </a>

    </div>

    @* Show the student's calculated attendance percentage. *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5">Overall Attendance</h2>

            <p class="display-6 mb-0">
                @Model.AttendancePercentage%
            </p>

        </div>
    </div>

    @* Display the existing attendance records without allowing changes. *@
    <section>

        <h2 class="h4 mb-3">Attendance History</h2>

        @if (Model.AttendanceRecords.Count == 0)
        {
            <div class="alert alert-info">
                No attendance records were found for this student.
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">

                    <table class="table table-striped table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Module</th>
                                <th>Session Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var record in Model.AttendanceRecords)
                            {
                                <tr>
                                    <td>
                                        @record.Session.StartTime.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @record.Session.ModuleOccurrence.Module.ModuleCode
                                        -
                                        @record.Session.ModuleOccurrence.Module.ModuleName
                                    </td>

                                    <td>
                                        @record.Session.SessionType
                                    </td>

                                    <td>
                                        @switch (record.Status)
                                        {
                                            case AttendanceMonitoringSystem.Models.AttendanceStatus.Present:
                                                <span class="badge bg-success">Present</span>
                                                break;

                                            case AttendanceMonitoringSystem.Models.AttendanceStatus.Absent:
                                                <span class="badge bg-danger">Absent</span>
                                                break;

                                            case AttendanceMonitoringSystem.Models.AttendanceStatus.AuthorisedAbsence:
                                                <span class="badge bg-info text-dark">Authorised Absence</span>
                                                break;

                                            case AttendanceMonitoringSystem.Models.AttendanceStatus.LateArrival:
                                                <span class="badge bg-warning text-dark">Late Arrival</span>
                                                break;

                                            case AttendanceMonitoringSystem.Models.AttendanceStatus.LeftEarly:
                                                <span class="badge bg-warning text-dark">Left Early</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">Not Recorded</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>
        }

    </section>

</div>