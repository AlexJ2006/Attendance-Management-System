
@model AttendanceMonitoringSystem.Models.CourseLeaderModuleViewModel

@{
    // Use the shared site layout and set the page title.
    Layout = "_Layout";
    ViewData["Title"] = "Module Attendance";
}

<div class="container mt-4">

    @* Display the selected module's details. *@
    <div class="mb-4">
        <h1>Module Attendance</h1>

        <h4 class="text-muted">
            @Model.Module.ModuleCode - @Model.Module.ModuleName
        </h4>

        <p>
            Course: @Model.Module.Course.CourseName
        </p>
    </div>

    @* Show the overall attendance percentage for this module. *@
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Students</h6>
                    <h3>@Model.Students.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Overall Attendance</h6>
                    <h3>@Model.AttendancePercentage%</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Below 80%</h6>
                    <h3>
                        @Model.Students.Count(s =>
                            s.TotalRecords > 0 &&
                            s.AttendancePercentage < 80)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    @* Show the attendance percentage for each student. *@
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Student Attendance</h5>
        </div>

        <div class="card-body">

            @if (Model.Students.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Attendance Records</th>
                                <th>Attended</th>
                                <th>Attendance Percentage</th>
                                <th>Monitoring</th>
                                <th>Details</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.StudentName</td>

                                    <td>@student.Email</td>

                                    <td>@student.TotalRecords</td>

                                    <td>@student.AttendedCount</td>

                                    <td>@student.AttendancePercentage%</td>

                                    <td>
                                        @if (student.TotalRecords == 0)
                                        {
                                            <span class="badge bg-secondary">
                                                No Records
                                            </span>
                                        }
                                        else if (student.AttendancePercentage < 80)
                                        {
                                            <span class="badge bg-danger">
                                                Below 80%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                On Track
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="CourseLeader"
                                           asp-action="Student"
                                           asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-primary">
                                            View Attendance
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                @* Explain when there are no students on the module's course. *@
                <p class="text-muted mb-0">
                    No students were found for this module.
                </p>
            }

        </div>
    </div>

    @* Return to the course containing this module. *@
    <a asp-controller="CourseLeader"
       asp-action="Course"
       asp-route-id="@Model.Module.CourseId"
       class="btn btn-outline-secondary">
        Back to Course
    </a>

</div>
