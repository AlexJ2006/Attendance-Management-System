
@model List<AttendanceMonitoringSystem.Models.ModuleLeaderAssignment>

@{
    ViewData["Title"] = "Module Leader Assignments";
}

<div class="container mt-4">
    <h1>Module Leader Assignments</h1>

    <p>Assign modules to Module Leaders and manage existing assignments.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Assign a Module</h2>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Module Leader</label>
                    <select name="moduleLeaderUserId"
                            asp-items="ViewBag.ModuleLeaders"
                            class="form-select"
                            required>
                        <option value="">Select a Module Leader</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Module</label>
                    <select name="moduleId"
                            asp-items="ViewBag.Modules"
                            class="form-select"
                            required>
                        <option value="">Select a module</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Assign Module
                </button>
            </form>
        </div>
    </div>

    <h2 class="h4 mb-3">Existing Assignments</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No Module Leader assignments have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Module Leader</th>
                        <th>Module Code</th>
                        <th>Module Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model)
                    {
                        <tr>
                            <td>@assignment.ModuleLeader.Name</td>
                            <td>@assignment.Module.ModuleCode</td>
                            <td>@assignment.Module.ModuleName</td>
                            <td>
                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Remove this assignment?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@assignment.ModuleLeaderAssignmentId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back
    </a>
</div>
