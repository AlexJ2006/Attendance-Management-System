@{
    var code = ViewData["StatusCode"] as int? ?? 0;
    ViewData["Title"] = code == 404 ? "Page not found" : "Request could not be completed";
}

<section class="status-page" aria-labelledby="status-heading">
    <h1 id="status-heading">@(code == 404 ? "Page not found" : "Request could not be completed")</h1>
    <div class="alert alert-warning" role="alert">
        @(code == 404
            ? "The page or record you asked for could not be found."
            : $"The request could not be completed (status {code}).")
    </div>
    <a class="btn btn-primary" href="/">Return to my dashboard</a>
</section>
