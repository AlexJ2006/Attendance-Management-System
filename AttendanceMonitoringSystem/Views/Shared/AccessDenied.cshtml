@{
    ViewData["Title"] = "Access denied";
}

<section class="status-page" aria-labelledby="denied-heading">
    <h1 id="denied-heading">Access denied</h1>
    <div class="alert alert-danger" role="alert">
        You do not have permission to view this page or these records.
    </div>
    <p>
        Access is limited to the modules, courses and students you are
        responsible for. If you think you should have access, contact I.T. Support.
    </p>
    <a class="btn btn-primary" href="/">Return to my dashboard</a>
</section>
