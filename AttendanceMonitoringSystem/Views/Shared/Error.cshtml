@model ErrorViewModel
@{
    ViewData["Title"] = "Service unavailable";
}

<section class="status-page" aria-labelledby="error-heading">
    <h1 id="error-heading">Sorry, something went wrong</h1>
    <div class="alert alert-danger" role="alert">
        The Attendance Monitoring System could not complete your request.
        No changes have been saved.
    </div>
    <p>
        This is usually temporary. Please wait a moment and try again.
        If the problem continues, contact I.T. Support and quote the reference below.
    </p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Reference:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">Return to my dashboard</a>
</section>
