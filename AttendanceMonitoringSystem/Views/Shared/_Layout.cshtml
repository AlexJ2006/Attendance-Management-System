@using AttendanceMonitoringSystem.Models
@using AttendanceMonitoringSystem.Services
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStudent = User.IsInRole(RoleNames.Student);
    var isTutor = User.IsInRole(RoleNames.Tutor);
    var isModuleLeader = User.IsInRole(RoleNames.ModuleLeader);
    var isCourseLeader = User.IsInRole(RoleNames.CourseLeader);
    var isAdviser = User.IsInRole(RoleNames.Adviser);
    var isAdmin = User.IsInRole(RoleNames.Administrator);
    var isStaff = isTutor || isModuleLeader || isCourseLeader || isAdviser || isAdmin;
}
<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Monitoring System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark ams-navbar mb-4" aria-label="Main navigation">
            <div class="container-fluid">
                <a class="navbar-brand" href="@(signedIn ? RoleHome.GetHomeUrl(User) : "/Index")">
                    <span class="ams-logo" aria-hidden="true">AMS</span>
                    <span class="ams-title">Attendance Monitoring System</span>
                </a>

                @if (signedIn)
                {
                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="mainNavbar" class="collapse navbar-collapse">
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link" href="@RoleHome.GetHomeUrl(User)">Home</a>
                            </li>

                            @if (isStudent)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Dashboard">My Attendance</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/MyModules">My Modules</a></li>
                            }

                            @if (isStaff)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="staffMenu" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">Staff</a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="staffMenu">
                                        @if (isTutor)
                                        {
                                            <li><h2 class="dropdown-header">Tutor</h2></li>
                                            <li><a class="dropdown-item" asp-controller="Tutor" asp-action="Index">Attendance Dashboard</a></li>
                                            <li><a class="dropdown-item" asp-controller="Sessions" asp-action="GenerateCode">Generate Attendance Code</a></li>
                                            <li><a class="dropdown-item" asp-controller="Sessions" asp-action="Create">Create Session</a></li>
                                        }
                                        @if (isModuleLeader)
                                        {
                                            <li><h2 class="dropdown-header">Module Leader</h2></li>
                                            <li><a class="dropdown-item" asp-controller="ModuleLeader" asp-action="Index">Module Leader Dashboard</a></li>
                                        }
                                        @if (isCourseLeader)
                                        {
                                            <li><h2 class="dropdown-header">Course Leader</h2></li>
                                            <li><a class="dropdown-item" asp-controller="CourseLeader" asp-action="Index">Course Leader Dashboard</a></li>
                                        }
                                        @if (isAdviser)
                                        {
                                            <li><h2 class="dropdown-header">Academic Adviser</h2></li>
                                            <li><a class="dropdown-item" asp-controller="Students" asp-action="AssignedToMe">My Advisees</a></li>
                                        }
                                        @if (isAdmin)
                                        {
                                            <li><h2 class="dropdown-header">Administrator</h2></li>
                                            <li><a class="dropdown-item" asp-page="/AdminDashboard">Administrator Dashboard</a></li>
                                            <li><a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">Manage Users</a></li>
                                            <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">All Students</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AttendanceReports" asp-action="Index">Reports</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account">Account</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-controller="User" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Log Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main id="main-content" role="main" class="pb-4" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container small">
            &copy; 2026 Attendance Monitoring System (AMS) &middot; Proof of Concept
            @if (signedIn)
            {
                <span class="ms-2">&middot; Signed in as @User.Identity!.Name</span>
            }
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
