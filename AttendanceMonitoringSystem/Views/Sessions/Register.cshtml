@model AttendanceMonitoringSystem.Models.LecturerAttendanceRegisterViewModel
@using AttendanceMonitoringSystem.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "Lecturer Attendance Register";
}

<div class="container session-page mb-5">

    <div class="session-page-header">
        <div>
            <h1 class="h2">Attendance Register</h1>
            <p class="text-muted mb-0">
                @Model.ModuleCode — @Model.ModuleName
            </p>
        </div>

        <a asp-controller="Tutor"
           asp-action="Index"
           asp-route-occurrenceId="@Model.ModuleOccurrenceId"
           class="btn btn-outline-secondary">
            Back to Attendance Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm session-info-card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">Session Details</h2>

            <div class="row">
                <div class="col-md-4 mb-2">
                    <strong>Session ID:</strong>
                    @Model.SessionId
                </div>

                <div class="col-md-4 mb-2">
                    <strong>Session Type:</strong>
                    @Model.SessionType
                </div>

                <div class="col-md-4 mb-2">
                    <strong>Status:</strong>
                    @Model.SessionStatus
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Start:</strong>
                    @Model.StartTime.ToString("dd MMM yyyy HH:mm")
                </div>

                <div class="col-md-6 mb-2">
                    <strong>End:</strong>
                    @Model.EndTime.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4 mb-3">Attendance Summary</h2>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-success h-100 session-summary-card">
                <div class="card-body">
                    <p class="text-muted mb-1">Present</p>
                    <p class="fs-3 fw-semibold mb-0 text-success">
                        @Model.PresentCount
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-danger h-100 session-summary-card">
                <div class="card-body">
                    <p class="text-muted mb-1">Absent</p>
                    <p class="fs-3 fw-semibold mb-0 text-danger">
                        @Model.AbsentCount
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-secondary h-100 session-summary-card">
                <div class="card-body">
                    <p class="text-muted mb-1">Not Recorded</p>
                    <p class="fs-3 fw-semibold mb-0">
                        @Model.NotRecordedCount
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm session-register-card">

        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Student Attendance</h2>
            <small class="text-muted">
                @Model.Students.Count student(s)
            </small>
        </div>

        <div class="card-body p-0">

            @if (Model.Students.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No students were found on this course.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col">Email</th>
                                <th scope="col">Attendance Status</th>
                                <th scope="col">Record or correct</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var student in Model.Students)
                            {
                                <tr>

                                    <td>
                                        @student.FirstName @student.LastName
                                    </td>

                                    <td>
                                        @student.Email
                                    </td>

                                    <td>
                                        <partial name="_StatusBadge" model="student.Status" />
                                    </td>

                                    <td>
                                        <form asp-controller="Sessions"
                                              asp-action="RecordManualAttendance"
                                              method="post"
                                              class="d-flex flex-column gap-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="sessionId"
                                                   value="@Model.SessionId" />

                                            <input type="hidden"
                                                   name="studentId"
                                                   value="@student.StudentId" />

                                            <select name="status"
                                                    class="form-select form-select-sm"
                                                    required
                                                    aria-label="Attendance status for @student.FirstName @student.LastName">

                                                <option value="">Select status</option>

                                                <option value="Present"
                                                        selected="@(student.Status == AttendanceStatus.Present)">
                                                    Present
                                                </option>

                                                <option value="Absent"
                                                        selected="@(student.Status == AttendanceStatus.Absent)">
                                                    Absent
                                                </option>

                                                <option value="AuthorisedAbsence"
                                                        selected="@(student.Status == AttendanceStatus.AuthorisedAbsence)">
                                                    Authorised Absence
                                                </option>

                                                <option value="LateArrival"
                                                        selected="@(student.Status == AttendanceStatus.LateArrival)">
                                                    Late Arrival
                                                </option>

                                                <option value="LeftEarly"
                                                        selected="@(student.Status == AttendanceStatus.LeftEarly)">
                                                    Left Early
                                                </option>

                                            </select>

                                            <input type="text"
                                                   name="reason"
                                                   class="form-control form-control-sm"
                                                   placeholder="Reason (required for changes)"
                                                   aria-label="Reason for changing the attendance of @student.FirstName @student.LastName"
                                                   maxlength="500" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-primary">
                                                @(student.AttendanceId == null
                                                    ? "Record Attendance"
                                                    : "Update Status")
                                            </button>

                                        </form>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
