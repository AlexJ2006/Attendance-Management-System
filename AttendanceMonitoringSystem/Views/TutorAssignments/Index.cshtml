@model List<AttendanceMonitoringSystem.Models.TutorAssignment>

@{
    ViewData["Title"] = "Tutor Assignments";
}

<!-- Main page for Administrators to manage Tutor assignments. -->
<div class="container mt-4">

    <h1>Tutor Assignments</h1>

    <p>
        Assign Tutors to module occurrences and manage existing assignments.
    </p>

    <!-- Display success or error messages after an action. -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Form for creating a new Tutor assignment. -->
    <div class="card mb-4">
        <div class="card-body">

            <h2 class="h5">Assign a Tutor</h2>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Tutor</label>

                    <select name="tutorUserId"
                            asp-items="ViewBag.Tutors"
                            class="form-select"
                            required>
                        <option value="">Select a Tutor</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Module Occurrence</label>

                    <select name="moduleOccurrenceId"
                            asp-items="ViewBag.Occurrences"
                            class="form-select"
                            required>
                        <option value="">Select a module occurrence</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Assign Tutor
                </button>

            </form>
        </div>
    </div>

    <!-- Display all existing Tutor assignments. -->
    <h2 class="h4 mb-3">Existing Assignments</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No Tutor assignments have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>Tutor</th>
                        <th>Module Code</th>
                        <th>Module Name</th>
                        <th>Academic Year</th>
                        <th>Semester</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var assignment in Model)
                    {
                        <tr>
                            <td>@assignment.Tutor.Name</td>

                            <td>
                                @assignment.ModuleOccurrence.Module.ModuleCode
                            </td>

                            <td>
                                @assignment.ModuleOccurrence.Module.ModuleName
                            </td>

                            <td>
                                @assignment.ModuleOccurrence.AcademicYear
                            </td>

                            <td>
                                @assignment.ModuleOccurrence.Semester
                            </td>

                            <td>
                                <!-- Remove only the assignment, not the related records. -->
                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Remove this Tutor assignment?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@assignment.TutorAssignmentId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Remove
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back
    </a>

</div>