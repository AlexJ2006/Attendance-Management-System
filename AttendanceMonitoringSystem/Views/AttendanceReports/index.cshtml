
@model AttendanceMonitoringSystem.Models.AttendanceReportViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Attendance Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Attendance Reports</h1>
            <p class="text-muted">
                Review attendance figures and individual student performance.
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Report Filters</h5>

            <form method="get" asp-controller="AttendanceReports" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date"
                               id="startDate"
                               name="startDate"
                               class="form-control"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-3">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date"
                               id="endDate"
                               name="endDate"
                               class="form-control"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-3">
                        <label for="courseId" class="form-label">Course</label>
                        <select id="courseId" name="courseId" class="form-select">
                            <option value="">All Courses</option>
                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.CourseId"
                                        selected="@(Model.CourseId == course.CourseId)">
                                    @course.CourseName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="moduleId" class="form-label">Module</label>
                        <select id="moduleId" name="moduleId" class="form-select">
                            <option value="">All Modules</option>
                            @foreach (var module in Model.Modules)
                            {
                                <option value="@module.ModuleId"
                                        selected="@(Model.ModuleId == module.ModuleId)">
                                    @module.ModuleCode - @module.ModuleName
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="AttendanceReports"
                       asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <h4 class="mb-3">Attendance Summary</h4>

    <div class="row g-3 mb-4">
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Attendance Percentage</h6>
                    <h2 class="text-primary">
                        @Model.AttendancePercentage%
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Present</h6>
                    <h2 class="text-success">@Model.PresentCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Absent</h6>
                    <h2 class="text-danger">@Model.AbsentCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Authorised Absence</h6>
                    <h2 class="text-info">@Model.AuthorisedAbsenceCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Late Arrival</h6>
                    <h2 class="text-warning">@Model.LateCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Left Early</h6>
                    <h2 class="text-secondary">@Model.LeftEarlyCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Not Recorded</h6>
                    <h2>@Model.NotRecordedCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Records</h6>
                    <h2>@Model.TotalRecords</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-3">Student Attendance Details</h4>

            @if (!Model.Students.Any())
            {
                <div class="alert alert-info">
                    No attendance records were found for the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Course</th>
                                <th>Sessions</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Authorised</th>
                                <th>Late</th>
                                <th>Left Early</th>
                                <th>Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@student.StudentName</td>
                                    <td>@student.Email</td>
                                    <td>@student.CourseName</td>
                                    <td>@student.TotalSessions</td>
                                    <td>@student.PresentCount</td>
                                    <td>@student.AbsentCount</td>
                                    <td>@student.AuthorisedAbsenceCount</td>
                                    <td>@student.LateCount</td>
                                    <td>@student.LeftEarlyCount</td>
                                    <td>
                                        <strong>@student.AttendancePercentage%</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
