@page
@model AttendanceMonitoringSystem.Pages.StudentDashboardModel
@using AttendanceMonitoringSystem.Models
@{
    ViewData["Title"] = "Student Dashboard";
}


<div class="container py-4">

    <div class="mb-4">
        <h1>Student Dashboard</h1>
        <p class="text-muted">
            Welcome back, @Model.StudentName!
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning" role="alert">
            @Model.Message
        </div>
    }

    <!-- Attendance overview -->
    <h4 class="mb-3">My Attendance Overview</h4>

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-start border-success border-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Attendance Percentage</p>
                    <h2 class="text-success mb-0">
                        @Model.AttendancePercentage.ToString("0.0")%
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-start border-primary border-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Sessions Attended</p>
                    <h2 class="text-primary mb-0">
                        @Model.AttendedCount
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-start border-danger border-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Absences</p>
                    <h2 class="text-danger mb-0">
                        @Model.AbsentCount
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-start border-warning border-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Late Arrivals</p>
                    <h2 class="text-warning mb-0">
                        @Model.LateCount
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>Attendance Breakdown</h5>

            <div class="row text-center g-3">
                <div class="col-6 col-md">
                    <h4>@Model.PresentCount</h4>
                    <span class="text-success">Present</span>
                </div>

                <div class="col-6 col-md">
                    <h4>@Model.AbsentCount</h4>
                    <span class="text-danger">Absent</span>
                </div>

                <div class="col-6 col-md">
                    <h4>@Model.LateCount</h4>
                    <span class="text-warning">Late</span>
                </div>

                <div class="col-6 col-md">
                    <h4>@Model.LeftEarlyCount</h4>
                    <span class="text-warning">Left Early</span>
                </div>

                <div class="col-6 col-md">
                    <h4>@Model.AuthorisedAbsenceCount</h4>
                    <span class="text-info">Authorised</span>
                </div>
            </div>

            <hr />

            <p class="text-muted small mb-0">
                @Model.RecordedSessionCount recorded sessions.
                Authorised absences are excluded from the attendance percentage.
            </p>
        </div>
    </div>

    <!-- Record attendance using a lecturer's session code -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Record My Attendance</h5>

            <p class="text-muted">
                Enter the six-digit code provided by your lecturer
                during your session.
            </p>

            <form method="post" asp-page-handler="SubmitCode">
                <div class="mb-3">
                    <label asp-for="SessionCodeInput" class="form-label">
                        Session code
                    </label>

                    <input asp-for="SessionCodeInput"
                           class="form-control"
                           maxlength="6"
                           minlength="6"
                           pattern="[0-9]{6}"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="Enter 6-digit code"
                           required />

                    <span asp-validation-for="SessionCodeInput"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Submit Attendance Code
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.AttendanceMessage))
            {
                <div class="alert @(Model.AttendanceMessageIsSuccess
                    ? "alert-success"
                    : "alert-warning") mt-3 mb-0"
                     role="alert">
                    @Model.AttendanceMessage
                </div>
            }
        </div>
    </div>

    <!-- Recent attendance history -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Recent Attendance History</h5>
        </div>

        <div class="card-body">
            @if (Model.SessionHistory.Count == 0)
            {
                <p class="text-muted mb-0">
                    You don't have any attendance records yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date and Time</th>
                                <th>Module</th>
                                <th>Session Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.SessionHistory.Take(10))
                            {
                                var statusClass = item.Status switch
                                {
                                    AttendanceStatus.Present => "bg-success",
                                    AttendanceStatus.Absent => "bg-danger",
                                    AttendanceStatus.LateArrival => "bg-warning text-dark",
                                    AttendanceStatus.LeftEarly => "bg-warning text-dark",
                                    AttendanceStatus.AuthorisedAbsence => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };

                                var statusText = item.Status switch
                                {
                                    AttendanceStatus.LateArrival => "Late Arrival",
                                    AttendanceStatus.LeftEarly => "Left Early",
                                    AttendanceStatus.AuthorisedAbsence => "Authorised Absence",
                                    _ => item.Status.ToString()
                                };

                                <tr>
                                    <td>@item.SessionDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>@item.ModuleName</td>
                                    <td>@item.SessionType</td>
                                    <td>
                                        <span class="badge @statusClass">
                                            @statusText
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.SessionHistory.Count > 10)
                {
                    <p class="text-muted small mb-0">
                        Showing the 10 most recent records.
                        Visit My Attendance to view your full history.
                    </p>
                }
            }
        </div>
    </div>

    <!-- Existing dashboard links -->
    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Attendance</h5>
                    <p class="card-text">
                        View your full attendance record and history.
                    </p>
                    <a asp-page="/MyAttendance" class="btn btn-primary">
                        View Attendance
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Modules</h5>
                    <p class="card-text">
                        View the modules associated with your studies.
                    </p>
                    <a asp-page="/MyModules" class="btn btn-primary">
                        View Modules
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Details</h5>
                    <p class="card-text">
                        View your student account details.
                    </p>
                    <p class="mb-0">@Model.StudentEmail</p>
                </div>
            </div>
        </div>

    </div>
</div>
