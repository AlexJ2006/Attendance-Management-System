
@page
@model AttendanceMonitoringSystem.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Attendance Dashboard</h1>
        <p class="text-muted">Welcome back, @Model.UserName.</p>
        <p>
            Your role(s):
            @foreach (var role in Model.Roles)
            {
                <span class="badge bg-secondary me-1">@role</span>
            }
        </p>
    </div>

    <div class="row g-4">
        @if (Model.Roles.Contains("Student"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Student Dashboard</h5>
                        <p class="card-text">
                            Review your attendance and recorded sessions.
                        </p>
                        <a asp-page="/StudentDashboard"
                           class="btn btn-primary">
                            View My Attendance
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Roles.Contains("Lecturer"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Lecturer</h5>
                        <p class="card-text">
                            Manage teaching sessions and student attendance.
                        </p>

                        <div class="d-grid gap-2 mb-4">
                            <a asp-controller="Sessions"
                               asp-action="Create"
                               class="btn btn-primary">
                                Create Teaching Session
                            </a>

                            <a asp-controller="Sessions"
                               asp-action="GenerateCode"
                               class="btn btn-success">
                                Generate Session Code
                            </a>

                            <a asp-controller="AttendanceReports"
                               asp-action="Index"
                               class="btn btn-outline-primary">
                                Attendance Reports
                            </a>
                        </div>

                        <hr class="my-4" />

                        <h6 class="mb-3">View Attendance Registers</h6>

                        @if (Model.RegisterSessions.Count == 0)
                        {
                            <p class="text-muted small">
                                No teaching sessions are available.
                            </p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var session in Model.RegisterSessions)
                                {
                                    <div class="list-group-item d-flex justify-content-between
                                                align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="fw-semibold">
                                                @session.Description
                                            </div>
                                        </div>

                                        <a asp-controller="Sessions"
                                           asp-action="Register"
                                           asp-route-id="@session.SessionId"
                                           class="btn btn-outline-primary btn-sm">
                                            View Register
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Message))
                        {
                            <div class="alert alert-info mt-3" role="status">
                                @Model.Message
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.GeneratedCode))
                        {
                            <div class="mt-3 p-3 border rounded">
                                <p class="mb-1">Attendance code</p>
                                <h3 class="text-center">@Model.GeneratedCode</h3>

                                <p class="mb-0 small text-muted">
                                    Expires at:
                                    @Model.CodeExpiresAt?.ToString("HH:mm:ss")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Roles.Contains("ModuleLeader"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Module Leader</h5>
                        <p class="card-text">
                            Review attendance across modules you lead.
                        </p>
                        <a asp-controller="Modules"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Modules
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Roles.Contains("CourseLeader"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Course Leader</h5>
                        <p class="card-text">
                            Review attendance across courses you lead.
                        </p>
                        <span class="text-muted">
                            Course leader tools to be implemented
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (Model.Roles.Contains("Adviser"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Adviser</h5>
                        <p class="card-text">
                            Support assigned students and review their attendance.
                        </p>

                        <a asp-controller="AttendanceReports"
                           asp-action="Index"
                           class="btn btn-primary">
                            Attendance Reports
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Roles.Contains("Administrator"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Administration</h5>
                        <p class="card-text">
                            Manage users and system access.
                        </p>

                        <div class="d-grid gap-2">
                            <a asp-controller="User"
                               asp-action="Index"
                               class="btn btn-primary">
                                User Management
                            </a>

                            <a asp-controller="AttendanceReports"
                               asp-action="Index"
                               class="btn btn-outline-primary">
                                Attendance Reports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a asp-page="/Logout"
           class="btn btn-outline-secondary">
            Log out
        </a>
    </div>
</div>
