@page
@model AttendanceMonitoringSystem.Pages.StudentDashboardModel
@{
    ViewData["Title"] = "Register Attendance";
}

<h1>Welcome, @Model.StudentName</h1>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning" role="alert">@Model.Message</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        @* Wireframe 3.2.2a - Register Attendance *@
        <section class="card shadow-sm register-card" aria-labelledby="register-heading">
            <div class="card-body">
                <h2 id="register-heading" class="h4 text-center mb-3">Register Attendance</h2>

                <form method="post" asp-page-handler="SubmitCode" novalidate>
                    <div class="mb-3">
                        <label for="SessionCodeInput" class="form-label">Attendance code</label>
                        <input id="SessionCodeInput"
                               name="SessionCodeInput"
                               value="@Model.SessionCodeInput"
                               class="form-control form-control-lg text-center code-input"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="ATTENDANCE CODE"
                               aria-describedby="code-help@(Model.AttendanceMessage != null ? " code-result" : "")" />
                        <div id="code-help" class="form-text">Enter the six-digit code shown by your tutor during the session.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Submit</button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.AttendanceMessage))
                {
                    <div id="code-result"
                         class="alert @(Model.AttendanceMessageIsSuccess ? "alert-success" : "alert-danger") mt-3 mb-0"
                         role="@(Model.AttendanceMessageIsSuccess ? "status" : "alert")">
                        <span aria-hidden="true">@(Model.AttendanceMessageIsSuccess ? "✓ " : "✗ ")</span>@Model.AttendanceMessage
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="card shadow-sm h-100" aria-labelledby="summary-heading">
            <div class="card-body">
                <h2 id="summary-heading" class="h5">My attendance at a glance</h2>
                <div class="row text-center my-3">
                    <div class="col">
                        <div class="display-6">@Model.AttendancePercentage.ToString("0.0")%</div>
                        <div class="text-muted small">Overall attendance</div>
                    </div>
                    <div class="col">
                        <div class="display-6">@Model.AttendedCount</div>
                        <div class="text-muted small">Sessions attended</div>
                    </div>
                    <div class="col">
                        <div class="display-6">@Model.AbsentCount</div>
                        <div class="text-muted small">Absences</div>
                    </div>
                </div>

                <h3 class="h6">Most recent sessions</h3>
                @if (Model.RecentHistory.Count == 0)
                {
                    <p class="text-muted">No attendance has been recorded yet.</p>
                }
                else
                {
                    <ul class="list-unstyled recent-list">
                        @foreach (var item in Model.RecentHistory)
                        {
                            <li>
                                <span>@item.SessionDate.ToString("dd MMM HH:mm") · @item.ModuleCode @item.SessionType</span>
                                <partial name="_StatusBadge" model="item.Status" />
                            </li>
                        }
                    </ul>
                }
                <a asp-page="/MyAttendance" class="btn btn-outline-primary">View my full attendance</a>
            </div>
        </section>
    </div>
</div>
