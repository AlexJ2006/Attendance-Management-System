@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AttendanceMonitoringSystem.Models.RoleNames.Administrator)]

@{
    // Set the browser page title.
    ViewData["Title"] = "Administrator Dashboard";
}

<!-- Main heading for the Administrator Dashboard. -->
<div class="container mt-4">
    <h1>Administrator Dashboard</h1>
    <p class="text-muted">
        Manage users, course leadership and module leadership assignments.
    </p>

    <hr />

    <!-- User Management section. -->
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h4 card-title">User Management</h2>
            <p class="card-text">
                View user accounts, activate or deactivate accounts,
                and manage user roles.
            </p>
            <a asp-controller="AdminUsers"
               asp-action="Index"
               class="btn btn-primary">
                Manage Users
            </a>
        </div>
    </div>

    <!-- Course Leader management section. -->
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h4 card-title">Course Leader Assignments</h2>
            <p class="card-text">
                View, create and remove Course Leader assignments.
            </p>
            <a asp-controller="CourseLeaderAssignments"
               asp-action="Index"
               class="btn btn-primary">
                Manage Course Leaders
            </a>
        </div>
    </div>

    <!-- Tutor management section. -->
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h4 card-title">Tutor Assignments</h2>
            <p class="card-text">
                Assign Tutors to the module occurrences they teach.
            </p>
            <a asp-controller="TutorAssignments"
               asp-action="Index"
               class="btn btn-primary">
                Manage Tutors
            </a>
        </div>
    </div>

    <!-- Attendance records and reports. -->
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h4 card-title">Attendance Records and Reports</h2>
            <p class="card-text">
                View every attendance record or generate a filtered report and export it as CSV.
            </p>
            <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-primary">All attendance records</a>
            <a asp-controller="AttendanceReports" asp-action="Index" class="btn btn-primary">Reports</a>
        </div>
    </div>

    <!-- Module Leader management section. -->
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h4 card-title">Module Leader Assignments</h2>
            <p class="card-text">
                View, create and remove Module Leader assignments.
            </p>
            <a asp-controller="ModuleLeaderAssignments"
               asp-action="Index"
               class="btn btn-primary">
                Manage Module Leaders
            </a>
        </div>
    </div>
</div>