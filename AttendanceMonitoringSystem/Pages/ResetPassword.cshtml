
@page
@model AttendanceMonitoringSystem.Pages.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="login-container">
    <div class="login-box">
        <h1>Reset your password</h1>
        <p class="subtitle">Enter your reset code and choose a new password.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="text-danger">@Model.ErrorMessage</p>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <p class="text-success">@Model.SuccessMessage</p>
        }

        @if (!string.IsNullOrEmpty(Model.DemoCode))
        {
            <div class="alert alert-info">
                <strong>Development demo code:</strong>
                <span>@Model.DemoCode</span>
                <p class="mb-0 small">This code is for local testing only.</p>
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" type="email" class="form-control"
                       autocomplete="email" required />
            </div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label">Reset code</label>
                <input asp-for="Code" class="form-control"
                       inputmode="numeric" pattern="[0-9]{6}"
                       maxlength="6" required />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New password</label>
                <input asp-for="NewPassword" type="password"
                       class="form-control" autocomplete="new-password"
                       minlength="8" required />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm new password
                </label>
                <input asp-for="ConfirmPassword" type="password"
                       class="form-control" autocomplete="new-password"
                       minlength="8" required />
            </div>

            <button type="submit" class="btn-signin">Reset Password</button>
        </form>

        <p class="mt-3">
            <a asp-page="/Index">Back to sign in</a>
        </p>
    </div>
</div>
