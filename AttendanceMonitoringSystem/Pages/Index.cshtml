@page
@model IndexModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="login-container">
    <section class="login-box" aria-labelledby="sign-in-heading">
        <h1 id="sign-in-heading">Sign In</h1>
        <p class="subtitle">Attendance Monitoring System</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger text-start" role="alert" id="login-error">
                @Model.ErrorMessage
            </div>
        }

        @* novalidate: messages come from the server so they are identical
           in every browser and are announced to screen readers. *@
        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label for="email">Email address <span class="required" aria-hidden="true">*</span></label>
                <input type="email"
                       id="email"
                       name="Email"
                       value="@Model.Email"
                       class="form-control"
                       placeholder="e.g. jamie.taylor@example.com"
                       autocomplete="username"
                       aria-required="true"
                       aria-describedby="@(Model.ErrorMessage != null ? "login-error" : null)" />
            </div>

            <div class="form-group">
                <label for="password">Password <span class="required" aria-hidden="true">*</span></label>
                <input type="password"
                       id="password"
                       name="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       aria-required="true" />
            </div>

            <button type="submit" class="btn-signin">Sign In</button>
        </form>

        <p class="mt-3 mb-1">
            <a asp-page="/ForgotPassword">Forgot password?</a>
        </p>
        <p class="text-muted small mb-0">
            OR<br />
            Contact I.T. Support to create an account.
        </p>
    </section>
</div>
