@page
@model AttendanceMonitoringSystem.Pages.MyModulesModel

@{
    ViewData["Title"] = "My Modules";
}

<div class="container mt-4">
    <h1>My Modules</h1>

    <p>Welcome, @Model.StudentName.</p>

    @if (!string.IsNullOrWhiteSpace(Model.CourseName))
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">My Course</h5>
                <p class="mb-1"><strong>@Model.CourseName</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.CourseCode))
                {
                    <p class="text-muted mb-0">Course code: @Model.CourseCode</p>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">
            @Model.Message
        </div>
    }

    @if (Model.Modules.Count > 0)
    {
        <h2 class="h4 mb-3">Your Modules</h2>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Module Code</th>
                        <th>Module Name</th>
                        <th>Academic Year</th>
                        <th>Semester</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var module in Model.Modules)
                    {
                        @if (module.ModuleOccurrences.Any())
                        {
                            @foreach (var occurrence in module.ModuleOccurrences
                                .OrderBy(o => o.AcademicYear)
                                .ThenBy(o => o.Semester))
                            {
                                <tr>
                                    <td>@module.ModuleCode</td>
                                    <td>@module.ModuleName</td>
                                    <td>@occurrence.AcademicYear</td>
                                    <td>@occurrence.Semester</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>@module.ModuleCode</td>
                                <td>@module.ModuleName</td>
                                <td colspan="2">No academic year or semester recorded</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-page="/StudentDashboard" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
