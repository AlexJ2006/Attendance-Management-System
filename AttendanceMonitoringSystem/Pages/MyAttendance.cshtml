@page
@model AttendanceMonitoringSystem.Pages.MyAttendanceModel

@{
    ViewData["Title"] = "My Attendance";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Attendance</h1>
            <p class="text-muted">Your personal attendance record.</p>
        </div>
        <a asp-page="/StudentDashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Attendance percentage</h6>
                        <h2>@Model.AttendancePercentage%</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Sessions attended</h6>
                        <h2>@Model.AttendedCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Sessions recorded</h6>
                        <h2>@Model.RecordedSessionCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Attendance History</h2>

                @if (Model.SessionHistory.Count == 0)
                {
                    <p class="text-muted">No attendance records were found for your account.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Date and time</th>
                                    <th>Module</th>
                                    <th>Session type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SessionHistory)
                                {
                                    <tr>
                                        <td>@item.SessionDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>@item.ModuleName</td>
                                        <td>@item.SessionType</td>
                                        <td>@item.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>