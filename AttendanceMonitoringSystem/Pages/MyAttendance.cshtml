@page
@model AttendanceMonitoringSystem.Pages.MyAttendanceModel
@{
    ViewData["Title"] = "My Attendance";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">My Attendance</h1>
    <a asp-page="/Dashboard" class="btn btn-primary">Register attendance</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@Model.Message</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Model.OverallPercentage.ToString("0.0")%</div>
            <div class="stat-label">Overall attendance</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Model.AttendedCount</div>
            <div class="stat-label">Sessions attended</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Model.AbsentCount</div>
            <div class="stat-label">Absences</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-value">@Model.AuthorisedCount</div>
            <div class="stat-label">Authorised absences</div>
        </div></div>
    </div>
</div>
<p class="text-muted small">
    Present, late arrival and left early count as attended. Authorised absences
    are not counted against you.
</p>

<div class="row g-4 mb-4">
    <section class="col-lg-6" aria-labelledby="module-heading">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h2 id="module-heading" class="h5">Attendance by module</h2>
            @foreach (var m in Model.Modules)
            {
                <div class="module-progress">
                    <div class="d-flex justify-content-between">
                        <span><strong>@m.ModuleCode</strong> @m.ModuleName</span>
                        <span>@(m.Sessions == 0 ? "No sessions yet" : m.Percentage.ToString("0.0") + "%")</span>
                    </div>
                    <div class="progress" role="progressbar"
                         aria-label="@m.ModuleCode attendance"
                         aria-valuenow="@m.Percentage.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(m.Percentage < 75 && m.Sessions > 0 ? "bg-warning-strong" : "")"
                             style="width: @m.Percentage.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                </div>
            }
        </div></div>
    </section>

    <section class="col-lg-6" aria-labelledby="month-heading">
        <div class="card shadow-sm h-100"><div class="card-body">
            <h2 id="month-heading" class="h5">Attendance by month</h2>
            @if (Model.Months.Count == 0)
            {
                <p class="text-muted">No data yet.</p>
            }
            else
            {
                @* Simple bar chart. The values are also printed as text, and
                   a data table follows for screen-reader users. *@
                <div class="bar-chart" aria-hidden="true">
                    @foreach (var month in Model.Months)
                    {
                        <div class="bar-chart-col">
                            <div class="bar-chart-value">@month.Percentage.ToString("0")%</div>
                            <div class="bar-chart-bar" style="height: @month.Percentage.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            <div class="bar-chart-label">@month.Label</div>
                        </div>
                    }
                </div>
                <table class="visually-hidden">
                    <caption>Attendance percentage by month</caption>
                    <thead><tr><th scope="col">Month</th><th scope="col">Attendance</th><th scope="col">Sessions</th></tr></thead>
                    <tbody>
                        @foreach (var month in Model.Months)
                        {
                            <tr><th scope="row">@month.Label</th><td>@month.Percentage.ToString("0.0")%</td><td>@month.Sessions</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div></div>
    </section>
</div>

<section class="card shadow-sm" aria-labelledby="history-heading">
    <div class="card-body">
        <h2 id="history-heading" class="h5">Attendance history</h2>
        @if (Model.History.Count == 0)
        {
            <p class="text-muted mb-0">No attendance records were found for your account.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <caption class="visually-hidden">Your attendance history, most recent first</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date and time</th>
                            <th scope="col">Module</th>
                            <th scope="col">Session type</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.History)
                        {
                            <tr>
                                <td>@item.SessionDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@item.ModuleCode – @item.ModuleName</td>
                                <td>@item.SessionType</td>
                                <td><partial name="_StatusBadge" model="item.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
