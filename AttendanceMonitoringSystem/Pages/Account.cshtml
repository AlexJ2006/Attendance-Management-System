@page
@model AttendanceMonitoringSystem.Pages.AccountModel
@using AttendanceMonitoringSystem.Models
@{
    ViewData["Title"] = "My Account";
}

<h1>My Account</h1>

<div class="row g-4">
    <div class="col-md-6">
        <section class="card shadow-sm h-100" aria-labelledby="details-heading">
            <div class="card-body">
                <h2 id="details-heading" class="h5">Account details</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.CurrentUser?.Name</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.CurrentUser?.Email</dd>
                    <dt class="col-sm-4">Roles</dt>
                    <dd class="col-sm-8">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@RoleNames.Display(role)</span>
                        }
                    </dd>
                </dl>
                <p class="small text-muted mt-3 mb-0">To change your name, email or roles, contact I.T. Support.</p>
            </div>
        </section>
    </div>
    <div class="col-md-6">
        <section class="card shadow-sm" aria-labelledby="password-heading">
            <div class="card-body">
                <h2 id="password-heading" class="h5">Change password</h2>
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }
                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
                }
                <form method="post" novalidate>
                    <div class="mb-3">
                        <label for="CurrentPassword" class="form-label">Current password</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label for="NewPassword" class="form-label">New password</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="new-help" />
                        <div id="new-help" class="form-text">At least 8 characters with upper-case, lower-case and a number.</div>
                    </div>
                    <div class="mb-3">
                        <label for="ConfirmPassword" class="form-label">Confirm new password</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary">Change password</button>
                </form>
            </div>
        </section>
    </div>
</div>
