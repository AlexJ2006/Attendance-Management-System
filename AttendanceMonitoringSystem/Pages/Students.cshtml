@model List<AttendanceMonitoringSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container">

    <h1>Students</h1>

    <p>List of all students on your course.</p>

    <table class="table">
        <thead>
            <tr>
                <th>Student Number</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Year</th>
                <th>Department</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.StudentId</td>
                    <td>@student.FirstName @student.LastName</td>
                    <td>@student.Email</td>
                    <td>@student.Course</td>
                    <td>@student.YearOfStudy</td>
                    <td>@student.Department</td>
                </tr>
            }
        </tbody>
    </table>

</div>