
@page
@model AttendanceMonitoringSystem.Pages.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="login-container">
    <div class="login-box">
        <h1>Forgot password?</h1>
        <p class="subtitle">
            Enter the email address associated with your account.
        </p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p>@Model.Message</p>
        }

        <form method="post">
            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   placeholder="Enter your email"
                   autocomplete="email"
                   required />

            <button type="submit" class="btn-signin">
                Request Reset Code
            </button>
        </form>
        @if (!string.IsNullOrEmpty(Model.DemoCode))
        {
            <script>
                window.alert("Your password reset code is: @Model.DemoCode");
            </script>

            <div class="alert alert-success mt-3">
                <h4>Your Reset Code</h4>
                <h2 class="text-center">@Model.DemoCode</h2>
                <p>Enter this code on the next screen.</p>

                <a asp-page="/ResetPassword"
                class="btn btn-primary mt-2">
                    Continue to Reset Password
                </a>
            </div>
        }

        <p class="mt-3">
            <a asp-page="/Index">Back to sign in</a>
        </p>
    </div>
</div>
