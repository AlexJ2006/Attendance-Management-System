/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">
</sql><sql name="SQL 2*">
-- 8. ADVISER ASSIGNMENTS
INSERT INTO &quot;AdviserAssignments&quot; (&quot;AdviserUserId&quot;, &quot;StudentId&quot;)
SELECT adviser.UserId, s.StudentId
FROM &quot;User&quot; adviser CROSS JOIN &quot;Student&quot; s
WHERE adviser.Email = 'taylor.wilson@example.com'
AND NOT EXISTS (
 SELECT 1 FROM &quot;AdviserAssignments&quot; aa
 WHERE aa.AdviserUserId = adviser.UserId AND aa.StudentId = s.StudentId
);

-- 9. MODULE OCCURRENCES
INSERT INTO &quot;ModuleOccurrence&quot; (&quot;ModuleId&quot;, &quot;AcademicYear&quot;, &quot;Semester&quot;)
SELECT m.ModuleId, '2026/2027', 'Semester 1'
FROM &quot;Module&quot; m
WHERE NOT EXISTS (
 SELECT 1 FROM &quot;ModuleOccurrence&quot; mo
 WHERE mo.ModuleId = m.ModuleId AND mo.AcademicYear = '2026/2027'
 AND mo.Semester = 'Semester 1'
);

-- 10. TEACHING SESSIONS
-- Integer Status=1 is example data; confirm your application's status mapping.
INSERT INTO &quot;TeachingSession&quot;
 (&quot;ModuleOccurrenceId&quot;, &quot;StartTime&quot;, &quot;EndTime&quot;, &quot;SessionType&quot;, &quot;Status&quot;)
SELECT mo.OccurrenceId, '2026-11-02 09:00:00', '2026-11-02 10:00:00', 'Lecture', 1
FROM &quot;ModuleOccurrence&quot; mo
WHERE mo.AcademicYear = '2026/2027' AND mo.Semester = 'Semester 1'
AND NOT EXISTS (
 SELECT 1 FROM &quot;TeachingSession&quot; ts
 WHERE ts.ModuleOccurrenceId = mo.OccurrenceId
 AND ts.StartTime = '2026-11-02 09:00:00' AND ts.SessionType = 'Lecture'
);

-- 11. ATTENDANCE RECORDS
-- Status=1 is an example only; verify enum/status meanings in your application.
INSERT INTO &quot;AttendanceRecord&quot;
 (&quot;StudentId&quot;, &quot;SessionId&quot;, &quot;Status&quot;, &quot;RecordedAt&quot;, &quot;RecordedByUserId&quot;)
SELECT s.StudentId, ts.SessionId, 1, '2026-11-02 10:05:00', recorder.UserId
FROM &quot;Student&quot; s
JOIN &quot;Course&quot; c ON c.CourseId = s.CourseId
JOIN &quot;Module&quot; m ON m.CourseId = c.CourseId
JOIN &quot;ModuleOccurrence&quot; mo ON mo.ModuleId = m.ModuleId
JOIN &quot;TeachingSession&quot; ts ON ts.ModuleOccurrenceId = mo.OccurrenceId
JOIN &quot;User&quot; recorder ON recorder.Email = 'casey.brown@example.com'
WHERE ts.StartTime = '2026-11-02 09:00:00'
AND NOT EXISTS (
 SELECT 1 FROM &quot;AttendanceRecord&quot; ar
 WHERE ar.StudentId = s.StudentId AND ar.SessionId = ts.SessionId
);

COMMIT;

-- VERIFICATION COUNTS
SELECT 'User' AS TableName, COUNT(*) AS Total FROM &quot;User&quot;
UNION ALL SELECT 'Role', COUNT(*) FROM &quot;Role&quot;
UNION ALL SELECT 'UserRole', COUNT(*) FROM &quot;UserRole&quot;
UNION ALL SELECT 'Course', COUNT(*) FROM &quot;Course&quot;
UNION ALL SELECT 'Cohort', COUNT(*) FROM &quot;Cohort&quot;
UNION ALL SELECT 'Module', COUNT(*) FROM &quot;Module&quot;
UNION ALL SELECT 'Student', COUNT(*) FROM &quot;Student&quot;
UNION ALL SELECT 'AdviserAssignments', COUNT(*) FROM &quot;AdviserAssignments&quot;
UNION ALL SELECT 'ModuleOccurrence', COUNT(*) FROM &quot;ModuleOccurrence&quot;
UNION ALL SELECT 'TeachingSession', COUNT(*) FROM &quot;TeachingSession&quot;
UNION ALL SELECT 'AttendanceRecord', COUNT(*) FROM &quot;AttendanceRecord&quot;;
</sql><sql name="SQL 3*">SELECT
    u.Name AS UserName,
    u.Email,
    r.name AS RoleName,
    ur.AssignedAt
FROM &quot;UserRole&quot; ur
JOIN &quot;User&quot; u ON u.UserId = ur.user_id
JOIN &quot;Role&quot; r ON r.RoleId = ur.role_id
ORDER BY u.Name, r.name;</sql><sql name="additional_sample_data.sql*" filename="/Users/alexjakeman/Desktop/additional_sample_data.sql">-- Reference to file &quot;/Users/alexjakeman/Desktop/additional_sample_data.sql&quot; (not supported by this version) --</sql><current_tab id="3"/></tab_sql></sqlb_project>
